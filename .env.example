# Runtime
GRIDCARBON_ENV=local
GRIDCARBON_LOG_LEVEL=INFO
# Local path (relative or absolute) or az://<container>/<prefix>
GRIDCARBON_STORAGE_URI=./data/lake

# Source credentials
